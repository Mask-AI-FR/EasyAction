# Service UTILISATEUR (`systemctl --user`), pas service système : la base est dans le dossier de
# l'utilisateur, en 0700. Un service système tournerait sous une autre identité et ne pourrait pas la
# lire. Livré NON ACTIVÉ ; le lanceur à la demande reste le chemin normal.
#   systemctl --user enable --now easyactions
[Unit]
Description=EasyActions server
Documentation=https://github.com/Mask-AI-FR/EasyAction
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/easyactions
# Les 13 variables sont TOUTES obligatoires (server/schemas/env.schema.ts:9-23) et le serveur refuse
# de démarrer sans elles : sans cette ligne l'unité échouerait à chaque fois. Le fichier est écrit au
# premier `easyactions`. `%h/.config` plutôt que XDG_CONFIG_HOME : systemd ne lit pas l'environnement
# de la session, et c'est l'emplacement par défaut.
EnvironmentFile=%h/.config/easyactions/env
ExecStartPre=/opt/easyactions/bin/easyactions-migrate migrate
ExecStart=/opt/easyactions/bin/easyactions-server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
