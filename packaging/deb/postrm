#!/bin/sh
# Les données sont dans le dossier de CHAQUE utilisateur : un script de paquet tourne en root et n'a
# pas à les parcourir. `purge` ne peut donc pas les effacer lui-même ; il dit comment le faire.
set -e

if [ "$1" = "purge" ]; then
  echo "EasyActions is removed. Per-user data was left in place; each user can delete theirs with:"
  echo "  rm -rf \"\${XDG_DATA_HOME:-\$HOME/.local/share}/easyactions\" \"\${XDG_CONFIG_HOME:-\$HOME/.config}/easyactions\""
fi

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
  fi
fi

exit 0
