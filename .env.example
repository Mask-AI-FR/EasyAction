# Pipliner server configuration, in two parts. Every variable of the first part is REQUIRED at boot: a
# missing one, or one still set to <TO_PROVIDE>, stops the server with the full list of names
# (server/config/env.ts). The second part is read only once, by `bun run settings:import-env`.
# Copy this file to .env for local use. Never commit .env (it is git-ignored).

# Interface the server listens on. Keep 127.0.0.1 outside a container; never publish on 0.0.0.0
# from a host (CLAUDE.md §7).
HOST=127.0.0.1

# HTTP port serving both the web app and its API on the same origin.
PORT=8094

# Exact public origin of the app (scheme, host, port; no path). Used for the GitHub callback URL and
# the Origin check on every POST. Must be https, except http on 127.0.0.1 / localhost.
APP_ORIGIN=http://127.0.0.1:8094

# Secret used to encrypt the short-lived sign-in cookie (the 10 minutes spent on GitHub's sign-in
# page). At least 32 characters. Generate one with:
#   openssl rand -base64 32
# Changing it only interrupts sign-ins in progress.
SESSION_SECRET=<TO_PROVIDE>

# Secret used to encrypt the GitHub tokens EasyActions keeps in its database. At least 32
# characters, different from SESSION_SECRET. Generate one with:
#   openssl rand -base64 32
# Keep it safe: changing or losing it signs everybody out (the stored tokens can no longer be read).
DATA_ENCRYPTION_KEY=<TO_PROVIDE>

# SQLite database file (sessions with their encrypted GitHub tokens, sign-in and security history).
# Create it, and bring it up to date after each upgrade, with the server stopped:
#   bun run db:migrate
# The server refuses to start while it is missing or out of date. Its backups must stay private.
DATABASE_PATH=./data/pipliner.sqlite

# Seconds a connection may stay silent before the server closes it. Bun's own default (10) is too
# short for a batch of pipeline runs waiting on GitHub. 30 to 255.
HTTP_IDLE_TIMEOUT_SECONDS=240

# "Stay signed in": days a browser stays signed in after signing in with GitHub (never longer than
# GitHub's refresh token, 6 months). 1 to 180.
SESSION_MAX_DAYS=30

# Browsers one person can be signed in on at the same time; one more signs the oldest out. 1 to 10.
SESSIONS_PER_USER_MAX=5

# Days the sign-in and security history is kept, then deleted. 30 to 3650.
AUDIT_RETENTION_DAYS=365

# Daily code: hours an accepted 6-digit code from the authenticator app stays valid for a browser
# (24 = once a day). 1 to 168.
TWO_FACTOR_EVERY_HOURS=24

# Wrong 6-digit or recovery codes allowed before codes are locked for a while. 3 to 20.
TWO_FACTOR_MAX_ATTEMPTS=5

# Minutes of the first lock; each following lock lasts twice as long (24 h at most). 1 to 1440.
TWO_FACTOR_LOCK_MINUTES=15

# ---------------------------------------------------------------------------------------------------
# Website settings. The server does NOT read the lines below. With the server stopped, after
# `bun run db:migrate`, run once:
#   bun run settings:import-env
# It copies them into the database (only the settings the database does not have yet). From then on
# an administrator changes them on the Settings page (/settings) and these lines are ignored.
# `bun run settings:import-env --replace` copies them again, over the database: the way back when a
# wrong GitHub connection locks everybody out, or after DATA_ENCRYPTION_KEY changed.
# ---------------------------------------------------------------------------------------------------

# GitHub web and API addresses. github.com values below; for GitHub Enterprise Server use
# https://<your-ghes> and https://<your-ghes>/api/v3; for GHE.com, https://<name>.ghe.com and
# https://api.<name>.ghe.com. Must be https (http only on 127.0.0.1).
GITHUB_WEB_URL=https://github.com
GITHUB_API_URL=https://api.github.com

# Your Pipliner GitHub App (Settings > Developer settings > GitHub Apps): its "Client ID", and a
# client secret generated on the same page. The import stores the secret encrypted with
# DATA_ENCRYPTION_KEY; you may then delete it from this file (the Settings page asks for it again at
# every change of the connection, and --replace needs it back here).
GITHUB_APP_CLIENT_ID=<TO_PROVIDE>
GITHUB_APP_CLIENT_SECRET=<TO_PROVIDE>

# Limits and timings. Optional: a missing one takes the default shown on the Settings page.

# Timeout of every call to GitHub, in milliseconds (1000 to 60000).
GITHUB_TIMEOUT_MS=10000

# Maximum repositories read per organization (GitHub sends 100 per page). Caps the cost of one page
# view; above it the list says it is truncated. 1 to 10000.
REPOS_MAX=1000

# Maximum branches read per repository (GitHub sends 100 per page). 1 to 1000.
BRANCHES_MAX=300

# A branch whose last commit is older than this many days is "stale": listed after the active
# ones, under "Stale" in the branch list. 1 to 3650.
ACTIVE_BRANCH_DAYS=90

# Maximum pipelines one "Run pipelines" may start. Every MaskAI workflow deploys: keep it small.
# 1 to 200.
DISPATCH_MAX_TARGETS=50

# Runs sent to GitHub at the same time (GitHub allows about 80 creations per minute). 1 to 10.
DISPATCH_CONCURRENCY=3

# Minimum seconds between two live-status checks of started runs (one GitHub call per repository
# per check; slower when many repositories are followed). 2 to 300.
RUN_POLL_MIN_SECONDS=10

# How long, in minutes, the live status of started runs is followed before showing "Status
# unknown" with a link to GitHub. 1 to 720.
RUN_TRACK_MAX_MINUTES=30
