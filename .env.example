# Pipliner server configuration. Every variable below is REQUIRED at boot: a missing one, or one still
# set to <TO_PROVIDE>, stops the server with the full list of names (server/config/env.ts).
# Copy this file to .env for local use. Never commit .env (it is git-ignored).
#
# The GitHub App connection (addresses, client ID, client secret) and the limits are NOT here: they are
# website settings, stored in the database. On a new install the server starts in setup mode; open the
# app, run `bun run settings:setup-code` and type the code and the GitHub App values on the /setup page.

# Interface the server listens on. Keep 127.0.0.1 outside a container; never publish on 0.0.0.0
# from a host (CLAUDE.md §7).
HOST=127.0.0.1

# HTTP port serving both the web app and its API on the same origin.
PORT=8094

# Exact public origin of the app (scheme, host, port; no path). Used for the GitHub callback URL and
# the Origin check on every POST. Must be https, except http on 127.0.0.1 / localhost.
APP_ORIGIN=http://127.0.0.1:8094

# Secret used to encrypt the short-lived sign-in cookie (the 10 minutes spent on GitHub's sign-in
# page). At least 32 characters. Generate one with:
#   openssl rand -base64 32
# Changing it only interrupts sign-ins in progress.
SESSION_SECRET=<TO_PROVIDE>

# Secret used to encrypt the GitHub tokens EasyActions keeps in its database. At least 32
# characters, different from SESSION_SECRET. Generate one with:
#   openssl rand -base64 32
# Keep it safe: changing or losing it signs everybody out (the stored tokens can no longer be read).
DATA_ENCRYPTION_KEY=<TO_PROVIDE>

# SQLite database file (sessions with their encrypted GitHub tokens, sign-in and security history).
# Create it, and bring it up to date after each upgrade, with the server stopped:
#   bun run db:migrate
# The server refuses to start while it is missing or out of date. Its backups must stay private.
DATABASE_PATH=./data/pipliner.sqlite

# Seconds a connection may stay silent before the server closes it. Bun's own default (10) is too
# short for a batch of pipeline runs waiting on GitHub. 30 to 255.
HTTP_IDLE_TIMEOUT_SECONDS=240

# "Stay signed in": days a browser stays signed in after signing in with GitHub (never longer than
# GitHub's refresh token, 6 months). 1 to 180.
SESSION_MAX_DAYS=30

# Browsers one person can be signed in on at the same time; one more signs the oldest out. 1 to 10.
SESSIONS_PER_USER_MAX=5

# Days the sign-in and security history is kept, then deleted. 30 to 3650.
AUDIT_RETENTION_DAYS=365

# Daily code: hours an accepted 6-digit code from the authenticator app stays valid for a browser
# (24 = once a day). 1 to 168.
TWO_FACTOR_EVERY_HOURS=24

# Wrong 6-digit or recovery codes allowed before codes are locked for a while. 3 to 20.
TWO_FACTOR_MAX_ATTEMPTS=5

# Minutes of the first lock; each following lock lasts twice as long (24 h at most). 1 to 1440.
TWO_FACTOR_LOCK_MINUTES=15
