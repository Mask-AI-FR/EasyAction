# Pipliner server configuration. Every variable below is REQUIRED at boot: a missing one, or one still
# set to <TO_PROVIDE>, stops the server with the full list of names (server/config/env.ts).
# Copy this file to .env for local use. Never commit .env (it is git-ignored).

# Interface the server listens on. Keep 127.0.0.1 outside a container; never publish on 0.0.0.0
# from a host (CLAUDE.md §7).
HOST=127.0.0.1

# HTTP port serving both the web app and its API on the same origin.
PORT=8094

# Exact public origin of the app (scheme, host, port; no path). Used for the GitHub callback URL and
# the Origin check on every POST. Must be https, except http on 127.0.0.1 / localhost.
APP_ORIGIN=http://127.0.0.1:8094

# Secret used to encrypt the session cookies (at least 32 characters). Generate one with:
#   openssl rand -base64 32
# Changing it signs everybody out.
SESSION_SECRET=<TO_PROVIDE>

# GitHub web and API addresses. github.com values below; for GitHub Enterprise Server use
# https://<your-ghes> and https://<your-ghes>/api/v3. Must be https (http only on 127.0.0.1).
GITHUB_WEB_URL=https://github.com
GITHUB_API_URL=https://api.github.com

# Your Pipliner GitHub App (Settings > Developer settings > GitHub Apps): its "Client ID", and a
# client secret generated on the same page. The secret stays in this file only.
GITHUB_APP_CLIENT_ID=<TO_PROVIDE>
GITHUB_APP_CLIENT_SECRET=<TO_PROVIDE>

# Timeout of every call to GitHub, in milliseconds (1000 to 60000).
GITHUB_TIMEOUT_MS=10000

# Maximum repositories read per organization (GitHub sends 100 per page). Caps the cost of one page
# view; above it the list says it is truncated. 1 to 10000.
REPOS_MAX=1000

# Maximum branches read per repository (GitHub sends 100 per page). 1 to 1000.
BRANCHES_MAX=300

# A branch whose last commit is older than this many days is "stale": listed after the active
# ones, under "Stale" in the branch list. 1 to 3650.
ACTIVE_BRANCH_DAYS=90

# Maximum pipelines one "Run pipelines" may start. Every MaskAI workflow deploys: keep it small.
# 1 to 200.
DISPATCH_MAX_TARGETS=50

# Runs sent to GitHub at the same time (GitHub allows about 80 creations per minute). 1 to 10.
DISPATCH_CONCURRENCY=3

# Minimum seconds between two live-status checks of started runs (one GitHub call per repository
# per check; slower when many repositories are followed). 2 to 300.
RUN_POLL_MIN_SECONDS=10

# How long, in minutes, the live status of started runs is followed before showing "Status
# unknown" with a link to GitHub. 1 to 720.
RUN_TRACK_MAX_MINUTES=30
